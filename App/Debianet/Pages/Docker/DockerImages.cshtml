@page
@model Debianet.Pages.Docker.DockerImagesModel
@{
}
<h1>Docker Images</h1>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Repository</th>
            <th>Tag</th>
            <th>Size</th>
            <th>Shared Size</th>
            <th>Unique Size</th>
            <th>Created At</th>
            <th>Digest</th>
        </tr>
    </thead>
    @foreach (var image in Model.Images)
    {
        <tr>
            <td>@image.ID</td>
            <td>@image.Repository</td> 
            <td>@image.Tag</td>
            <td>@image.Size</td>
            <td>@image.SharedSize</td>
            <td>@image.UniqueSize</td>
            <td>@image.CreatedAt</td>
            <td>@image.Digest</td>
        </tr>
    }
</table>