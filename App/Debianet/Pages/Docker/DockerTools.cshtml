@page
@model Debianet.Pages.Docker.DockerToolsModel
@{
}

<h1>Debianet Docker tools</h1>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tool in Model.DockerTools)
        {
            <tr>
                <td>@tool.Name</td>
                <td>
                    @tool.Description<br />
                    <a href="@tool.Link" target="_blank">@tool.Link</a>
                </td>
                <td>
                    <form method="post" asp-page="/Docker/DockerToolChange">
                        <input type="hidden" asp-for="@tool.Name" name="ToolName" />
                        <input type="hidden" asp-for="@tool.ContainerId" name="ContainerId" />
                        @if (string.IsNullOrEmpty(tool.ContainerId))
                        {
                            <button type="submit" class="btn btn-primary">Start</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-secondary">Stop</button> 
                            <a class="btn btn-light" href="@tool.Url" target="_blank">Open</a>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>