@page
@model Debianet.Pages.DockerNetworksModel
@{
}
<h1>Docker Networks</h1>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Scope</th>
            <th>Driver</th>
            <th>IPv4</th>
            <th>IPv6</th>
        </tr>
    </thead>
    @foreach (var network in Model.Networks)
    {
        <tr>
            <td>@network.Name</td>
            <td>@network.Scope</td>
            <td>@network.Driver</td>
            <td>@network.IPv4</td>
            <td>@network.IPv6</td>
        </tr>
    }
</table>