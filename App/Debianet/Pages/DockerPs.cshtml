@page
@model Debianet.Pages.DockerPsModel
@{
}
<h1>Running Docker containers</h1>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Names</th>
            <th>Image</th>
            <th>Command</th>
            <th>Created At</th>
            <th>Status</th>
            <th>Mounts</th>
            <th>Networks</th>
            <th>Ports</th>
        </tr>
    </thead>
    @foreach (var process in Model.DockerPs)
    {
        <tr>
            <td>@process.ID</td>
            <td>@process.Names</td>
            <td>@process.Image</td>
            <td>@process.Command</td>
            <td>@process.CreatedAt</td>
            <td>@process.Status</td>
            <td>@process.Mounts</td>
            <td>@process.Networks</td>
            <td>@process.Ports</td>
        </tr>
    }
</table>