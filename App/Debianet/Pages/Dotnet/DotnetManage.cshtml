@page
@model Debianet.Pages.Dotnet.DotnetManageModel
@{
    ViewData["Title"] = ".NET info & management";
}
<h1>.NET info &amp; management</h1>
<div class="tabs two">
    <input id='tab-1' type='radio' name='tabgroupB' checked />
    <label class="pseudo button toggle" for="tab-1">Runtimes</label>
    <input id='tab-2' type='radio' name='tabgroupB'>
    <label class="pseudo button toggle" for="tab-2">Sdks</label>
    <input id='tab-3' type='radio' name='tabgroupB'>
    <div class="row">
        <div>
            @Html.Raw(Model.DotnetRuntimes.ToHtmlTable(firstRowHeader: true))
        </div>

        <div>
            @Html.Raw(Model.DotnetSdks.ToHtmlTable(firstRowHeader: true))
        </div>
    </div>
</div>

<label for="modal_1" class="button">Workloads...</label>
<label for="modal_2" class="button">Templates...</label>

<div class="modal">
    <input id="modal_1" type="checkbox" />
    <label for="modal_1" class="overlay"></label>
    <article>
        <header>
            <h3>Workloads</h3>
            <label for="modal_1" class="close">&times;</label>
        </header>
        <section class="content">
            <pre>@Model.DotnetWorkloads</pre>
        </section>
        <footer>
            <label for="modal_1" class="button dangerous">Ok</label>
        </footer>
    </article>
</div>

<div class="modal">
    <input id="modal_2" type="checkbox" />
    <label for="modal_2" class="overlay"></label>
    <article>
        <header>
            <h3>Workloads</h3>
            <label for="modal_2" class="close">&times;</label>
        </header>
        <section class="content">
            <pre>@Model.DotnetTemplates</pre>
        </section>
        <footer>
            <label for="modal_2" class="button dangerous">Ok</label>
        </footer>
    </article>
</div>

<h2>Management</h2>

<p>
    <a asp-area="" class="button" asp-page="/PerformAction" asp-route-title="Updating .NET wokrloads..." asp-route-action="update-workloads">Update workloads</a>
    <a asp-area="" class="button" asp-page="/PerformAction" asp-route-title="Updating .NET tools..." asp-route-action="update-installed-tools">Update installed tools</a>
    <a asp-area="" class="button" asp-page="/PerformAction" asp-route-title="Clearing NuGet cache..." asp-route-action="clear-nuget-local-cache">Clear NuGet local cache</a>
</p>
