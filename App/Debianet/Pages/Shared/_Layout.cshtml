<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Debianet</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/picnic.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/style.css" asp-append-version="true" />
</head>
<body>

    <div class="container">

        <div class="nav">
            <ul>
                <li><a asp-area="" asp-page="/SystemInfo">System Info</a></li>
                <li>
                    .NET
                    <ul>
                        <li><a asp-area="" asp-page="/Dotnet/DotnetManage">.NET info &amp; management</a></li>
                        <li><a asp-area="" asp-page="/Dotnet/DotnetTools">Debianet .NET tools installer</a></li>
                        <li><a asp-area="" asp-page="/Dotnet/DotnetGlobalTools">Installed .NET global tools</a></li>
                    </ul>
                </li>
                <li>
                    Docker
                    <ul>
                        <li><a asp-area="" asp-page="/Docker/DockerTools">Debianet Docker tools</a></li>
                        <li><a asp-area="" asp-page="/Docker/DockerPs">Running containers</a></li>
                        <li><a asp-area="" asp-page="/Docker/DockerImages">Images</a></li>
                        <li><a asp-area="" asp-page="/Docker/DockerNetworks">Networks</a></li>
                        <li><a asp-area="" asp-page="/Docker/DockerVolumes">Volumes</a></li>
                    </ul>
                </li>
                <li><a asp-area="" asp-page="/RenderMarkdown" asp-route-doc="license">License</a></li>
                <li><a asp-area="" asp-page="/RenderMarkdown" asp-route-doc="changelog">Changelog</a></li>
            </ul>
        </div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
