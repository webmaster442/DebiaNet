@page
@model Debianet.Pages.SystemInfoModel
@{
}
<h1>System Information</h1>
<table class="table">
    <tr>
        <td>Host name</td>
        <td>@Model.Info.HostName</td>
    </tr>
    <tr>
        <td>Kernel</td>
        <td>@Model.Info.KernelInfo</td>
    </tr>
    <tr>
        <td>Uptime</td>
        <td>@Model.Info.UpTime</td>
    </tr>
    <tr>
        <td>Shell</td>
        <td>@Model.Info.Shell</td>
    </tr>
    <tr>
        <td>Cpu</td>
        <td>@Model.Info.CpuInfo</td>
    </tr>
</table>

<h2>Memory Information</h2>
<table class="table">
@foreach (var mem in Model.Info.MemoryInfo.Rows)
{
    <tr>
    @foreach (var col in mem.Columns)
    {
        <td>@col</td>
    }
    </tr>
}
</table>

<h2>Disk Information</h2>
<table class="table">
@foreach (var mem in Model.Info.DiskInfo.Rows)
{
    <tr>
        @foreach (var col in mem.Columns)
        {
            <td>@col</td>
        }
    </tr>
}
</table>